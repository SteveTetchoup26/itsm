# Copy this file to .env (never committed) and set real values.
# Use letters and digits only: some characters (@, ", /) break Oracle connection strings.

# SYS and SYSTEM password (administration only, never used by the application)
ORACLE_PASSWORD=change-me

# Schema owner, used by Flyway
ITSM_OWNER_PASSWORD=change-me

# Application account, read/write on data only
ITSM_APP_PASSWORD=change-me

# Host port (loopback only)
ORACLE_PORT=1521
