# Production settings for compose.prod.yml. Copy to .env.prod on the VM (never committed).
# Passwords: those of the Autonomous Database accounts (deploy/adb), not the local ones.

# Public name of the application (DuckDNS); "localhost" for a local test
ITSM_DOMAIN=change-me.duckdns.org

# Image tags published by the pipeline (sha-<short commit>); set by the deployment (I0-11)
ITSM_BACKEND_TAG=sha-change-me
ITSM_FRONTEND_TAG=sha-change-me

# JDBC URL of the itsm_tp service, TLS without wallet (ADR-017):
# jdbc:oracle:thin:@(description= ... (protocol=tcps)(port=1521) ... (security=(ssl_server_dn_match=yes)))
ITSM_DB_URL=change-me

ITSM_OWNER_PASSWORD=change-me
ITSM_APP_PASSWORD=change-me
